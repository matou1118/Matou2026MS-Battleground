# ============================================================
#  码头哥 2026 MS 战场版 —— .gitignore
#
#  本文件的首要目的：防止误提交暴雪娱乐的受版权保护数据。
#  DBC / maps / mmaps / vmaps 绝不能进入本仓库。
# ============================================================

# ---------------------------------------------------------
# 一、暴雪娱乐数据（绝对禁止提交）
# ---------------------------------------------------------
*.dbc
*.mdb
*.mdx
data/dbc/
data/maps/
data/mmaps/
data/vmaps/
data/cameras/

# 客户端资源与可执行文件
*.exe
*.dll
*.pdb
*.ilk
*.mpq
*.p01
*.p02
*.casc
*.patch
*.vpatch

# ---------------------------------------------------------
# 二、数据库转储（含用户角色数据）
# ---------------------------------------------------------
*.sql.gz
*.sql.zip
!data/sql/**/*.sql
!docs/**/*.sql
db/
*.dump
*.dump.cnf

# ---------------------------------------------------------
# 三、凭据与本地配置（绝不能提交）
# ---------------------------------------------------------
# 只提交 .dist 模板
configs/*.conf
configs/modules/*.conf
!configs/*.conf.dist
!configs/modules/*.conf.dist

*.cnf
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
credentials*
secrets*
*_account.xlsx
*GM*.xlsx
*账号*.xlsx
*密码*.xlsx

# ---------------------------------------------------------
# 四、运行时产物
# ---------------------------------------------------------
logs/
Crashes/
crash/
*.log
*.dmp
*.stackdump
pid/
temp/
logs_old/

# ---------------------------------------------------------
# 五、编译产物
# ---------------------------------------------------------
build/
Build/
build_*/
deps/
out/
install/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.cmake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.deps/
*.gcda
*.gcno

# ---------------------------------------------------------
# 六、IDE 与编辑器
# ---------------------------------------------------------
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.swp
*.swo
*~
.\#*
\#*\#

# ---------------------------------------------------------
# 七、数据库运行时
# ---------------------------------------------------------
mysql-data/
ib_logfile*
ibdata*
*.err
*.pid

# ---------------------------------------------------------
# 八、备份与临时文件
# ---------------------------------------------------------
*.bak
*.orig
*.rej
*.tmp
*.temp
*.old
*.backup
*~

# ---------------------------------------------------------
# 九、操作系统
# ---------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------------------------------------------------------
# 十、明确保留（覆盖上面的通用规则）
# ---------------------------------------------------------
# 炉石脚本的原始版本 —— 保留以供对照与溯源
!lua_scripts/*.ORIGINAL.bak

!LICENSE
!NOTICE.md
!DISCLAIMER.md
!AUTHORS.md
!CHANGELOG.md
!README.md
!CONTRIBUTING.md
!scripts/*.py
!patches/*.patch
